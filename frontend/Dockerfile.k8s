# Imagen de producción para Kubernetes (H-16): build estático servido por nginx.
# El Dockerfile original (modo dev) no se modifica.
FROM node:20-alpine AS build

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .

# Modo gateway: las URLs de API son relativas (/api/<servicio>) y las resuelve el Ingress.
ENV VITE_API_MODE=gateway
RUN npm run build

FROM nginx:alpine

RUN printf 'server {\n  listen 80;\n  root /usr/share/nginx/html;\n  index index.html;\n  location / {\n    try_files $uri $uri/ /index.html;\n  }\n}\n' > /etc/nginx/conf.d/default.conf

COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80
