# ============================================
# EPS Digital - Entorno Local Docker
# ============================================
# Copiar este archivo a .env antes de iniciar
# cp .env.example .env
# ============================================

# Logging
LOG_LEVEL=debug

# JWT Secret (usar una clave larga y aleatoria)
JWT_SECRET_KEY=your_jwt_secret_key_here

# --- Database ---
# Postgres URL (para desarrollo local)
DATABASE_URL=url_postgres_aqui

# --- Service URLs (para comunicacion interna entre servicios) ---
AUTH_SERVICE_URL=http://localhost:8001
USER_SERVICE_URL=http://localhost:8002
CITAS_SERVICE_URL=http://localhost:8003
CATALOG_SERVICE_URL=http://localhost:8004
AI_NLP_SERVICE_URL=http://localhost:8005
NOTIFICATIONS_SERVICE_URL=http://localhost:8006

# --- External Service URLs (para el frontend) ---
VITE_AUTH_URL=http://localhost:8001
VITE_USER_URL=http://localhost:8002
VITE_CITAS_URL=http://localhost:8003
VITE_CATALOGO_URL=http://localhost:8004
VITE_AI_URL=http://localhost:8005
VITE_NOTIFICACIONES_URL=http://localhost:8006

# --- AI/NLP Service ---
# Requiere clave de Groq API (https://console.groq.com)
# Requiere clave de Cerebras API (https://console.cerebras.net)
# Requiere clave de Mistral API (https://console.mistral.ai)
GROQ_API_KEY=your_groq_api_key_here
CEREBRAS_API_KEY=your_cerebras_api_key_here
MISTRAL_API_KEY=your_mistral_api_key_here

# --- Gemini API Keys ---
# Requiere clave de Gemini API (https://www.gemini.com/)
GEMINI_API_KEY_1=your_gemini_api_key_1_here
GEMINI_API_KEY_2=your_gemini_api_key_2_here
GEMINI_API_KEY_3=your_gemini_api_key_3_here

# --- Notifications Service ---
# Opcional - SendGrid para envio de emails
# Si no se configura, el servicio solo hara logging
SENDGRID_API_KEY=your_sendgrid_api_key_here
SENDGRID_FROM_EMAIL=your_sendgrid_from_email_here

# --- RabbitMQ ---
# Para desarrollo local (guest/guest)
# Production: cambiar credenciales
RABBITMQ_URL=localhost

# --- Notifications Service ---
# Habilitar/deshabilitar consumidor RabbitMQ en el notifications-service
# En local: false (evita spam de reconexion si no tienes RabbitMQ corriendo)
# En produccion: true
RABBITMQ_ENABLED=false